+  width: 20px; height: 20px; border-radius: 50%; background: var(--ink); color: var(--paper);
+  display: grid; place-items: center; font: 700 12px var(--sans); flex: 0 0 auto;
+}
+.top3-body { margin-top: 6px; font-size: 13px; color: var(--ink-2); }
+.top3-body p { margin: 3px 0; }
+.top3-body b { color: var(--ink); font-weight: 600; }
+
+/* ---- 报告原文弹窗 ---- */
+.rawtext {
+  max-height: 46vh; overflow: auto; white-space: pre-wrap; word-break: break-all;
+  background: var(--surface-2); border: 1px solid var(--line);
+  border-radius: var(--radius-sm); padding: 12px; margin: 0;
+  font: 12.5px/1.6 var(--mono); color: var(--ink-2);
+}
+
+/* ================= V3.1 · 体验反馈修复 ================= */
+
+/* 待确认卡片：新增标签较多，允许换行 */
+.pend-head { flex-wrap: wrap; row-gap: 4px; }
+.pend-head .muted { margin-left: auto; }
+
+/* 趋势页顶部：入库完成 → 倒计时自动进入评估 的流转横幅 */
+.trend-banner {
+  display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
+  margin: 0 0 18px; padding: 12px 16px;
+  background: var(--t1-bg); color: var(--t1);
+  border: 1px solid color-mix(in srgb, var(--t1) 30%, transparent);
+  border-radius: var(--radius-sm); font-size: 13.5px; line-height: 1.6;
+}
+.trend-banner .tb-ops { margin-left: auto; display: flex; gap: 8px; }
+
+/* 概率的人话解释（频数表述） */
+.hero-plain {
+  margin: 4px 0 14px; padding: 10px 14px;
+  background: var(--surface-2); border-left: 3px solid var(--ink-3);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  font-size: 13px; line-height: 1.7; color: var(--ink-2);
+}
+
+/* 总览每项：可能的疾病发展方向（风险提示，非诊断） */
+.ov-dir {
+  margin-top: 6px; padding: 7px 10px;
+  background: var(--t2-bg); color: var(--t2);
+  border-radius: var(--radius-sm); font-size: 12.5px; line-height: 1.6;
+}
+.ov-dir b { color: inherit; }
+
+/* ④ 生活方式建议摘要（饮食 / 运动两栏） */
+.ls-grid {
+  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: 12px;
+}
+.ls-cell {
+  background: var(--surface-2); border: 1px solid var(--line);
+  border-radius: var(--radius-sm); padding: 12px 14px;
+}
+.ls-t { font-weight: 700; font-size: 13.5px; margin-bottom: 8px; }
+.ls-g { font-size: 12.5px; line-height: 1.65; color: var(--ink-2); }
+.ls-g + .ls-g { margin-top: 8px; }
+.ls-g b { color: var(--ink); }
+.ls-g ul { margin: 3px 0 0; padding-left: 18px; }
+.ls-g li { margin: 2px 0; }
+
+/* ================= V3.2 · 上传节奏统一 ================= */
+
+/* 入库后的"下一步"条：中性底色，与倒计时横幅（t1 色系）区分开 */
+.nextstep {
+  display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
+  margin-top: 14px; padding: 12px 16px;
+  background: var(--surface-2); border: 1px solid var(--line);
+  border-left: 3px solid var(--t1);
+  border-radius: var(--radius-sm); font-size: 13px; line-height: 1.6;
+  color: var(--ink-2);
+}
+.nextstep b { color: var(--t1); }
+.nextstep .tb-ops { margin-left: auto; display: flex; gap: 8px; }
+
+/* ===================== V3.2 分系统风险评估 ===================== */
+.sys-risk-title { font-size: 15px; font-weight: 600; margin-bottom: 12px; }
+.sys-risk-title .muted { font-weight: 400; font-size: 12px; margin-left: 6px; }
+.sys-risk-grid { display: flex; flex-direction: column; gap: 10px; }
+.sys-risk-card {
+  padding: 12px 14px; border-radius: var(--radius-sm);
+  transition: box-shadow .2s;
+}
+.sys-risk-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.08); }
+.sys-risk-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.sys-risk-head b { font-size: 14px; }
+.sys-icon { font-size: 16px; font-weight: 700; }
+.sys-level { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 10px; background: rgba(255,255,255,.6); }
+.sys-dept { font-size: 11px; color: var(--ink-3); margin-left: auto; }
+.sys-bar { height: 4px; background: #eee; border-radius: 2px; margin: 8px 0 6px; overflow: hidden; }
+.sys-bar i { display: block; height: 100%; border-radius: 2px; transition: width .4s ease; }
+.sys-inds { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 12px; color: var(--ink-2); margin-top: 4px; }
+.sys-ind b { font-weight: 600; }
+.sys-ind .worse { color: #f5222d; font-size: 11px; font-style: normal; font-weight: 600; }
+.sys-dir { font-size: 11px; color: var(--ink-3); margin-top: 6px; padding: 4px 8px; background: rgba(0,0,0,.03); border-radius: 4px; }
+.sys-stable { margin-top: 10px; font-size: 13px; color: #52c41a; padding: 8px 12px; background: #f6ffed; border-radius: var(--radius-sm); }
+.ai-narrative {
+  margin-top: 14px; padding: 14px 16px;
+  background: linear-gradient(135deg, #f0f7ff, #f8f0ff);
+  border: 1px solid #d6e4ff; border-radius: var(--radius-sm);
+}
+.ai-narrative-title { font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--ink-1); }
+.ai-narrative p { font-size: 13px; line-height: 1.8; color: var(--ink-2); margin: 0; }
+
+/* ================= V3.3：评估内嵌风险走势 + ⑥下一步导航 + AI 文本 ================= */
+.mini-risk{margin-top:16px;border:1px solid var(--line);border-radius:14px;
+  padding:12px 14px;background:var(--paper-2)}
+.mini-risk-head{display:flex;align-items:center;justify-content:space-between;
+  gap:10px;margin-bottom:6px;font-size:13px}
+.mini-risk .chart{height:220px}
+@media (max-width:640px){.mini-risk .chart{height:190px}}
+
+.next-lead{margin:0 0 10px;font-size:13.5px;line-height:1.7;color:var(--ink-2)}
+.next-lead b{color:var(--ink)}
+.next-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
+.next-grid .btn{flex:1 1 200px}
+
+.ai-sub{font-size:12px;color:var(--ink-3);margin:0 0 10px;padding:8px 10px;
+  border-left:3px solid var(--line);background:var(--paper-2);border-radius:0 8px 8px 0}
+.ai-para{margin:0 0 10px;line-height:1.75}
+.ai-para:last-child{margin-bottom:0}
+
+/* ================= V3.4 · 向导式流程 ================= */
+
+/* 步骤条可点击（点击滚动到对应区块） */
+.step { cursor: pointer; user-select: none; transition: transform .12s ease; }
+.step:hover { transform: translateY(-1px); }
+.step:active { transform: translateY(0); }
+
+/* 流程卡：提示语单独一行，按钮组右对齐；窄屏自动换行 */
+.nextstep { row-gap: 6px; }
+.nextstep .fc-hint {
+  flex-basis: 100%; font-size: 12.5px; color: var(--ink-3);
+}
+
+/* 时间轴就绪后的双按钮行 */
+.cta-row { display: flex; gap: 10px; }
+.cta-row .btn { flex: 1; }
+
+/* 趋势页引导条关闭键 */
+.trend-banner #tgClose { padding-inline: 10px; }
