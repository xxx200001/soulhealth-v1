+def _over_text(value: float, ref_low, ref_high, grade: int) -> str:
+    """把偏离量说成人话：超上限 1.8 倍 / 低于下限 25%。算不出就返回空。"""
+    try:
+        if grade > 0 and ref_high not in (None, 0):
