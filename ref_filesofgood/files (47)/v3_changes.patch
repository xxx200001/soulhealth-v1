+            if k > 1.005:
+                txt = f"{k:.1f}"
+                return "略超上限" if txt == "1.0" else f"达上限的 {txt} 倍"
+        if grade < 0 and ref_low not in (None, 0):
+            pct = (float(ref_low) - value) / abs(float(ref_low)) * 100
+            if pct > 0.5:
+                return f"低于下限约 {pct:.0f}%"
+    except (TypeError, ZeroDivisionError, ValueError):
+        pass
+    return ""
