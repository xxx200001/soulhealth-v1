# ---- SOULHEALTH V1 环境配置（复制为 .env）----

# 真实视觉抽取 / 问询 LLM 表达（可选）
# ANTHROPIC_API_KEY=sk-ant-...
# SOULHEALTH_LLM_MODEL=claude-sonnet-4-6

# 离线演示模式：按文件名路由内置样例，全流程可离线跑通（AC-20）
SOULHEALTH_MOCK=1

# 启动时自动播种演示档案 demo/demo123456（默认开）
SOULHEALTH_SEED_DEMO=1

SOULHEALTH_PORT=8001
SOULHEALTH_SECRET=please-change-me-to-a-long-random-string
