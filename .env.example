# ---- SOULHEALTH V1 预置环境配置 ----
# 对方拿到代码后：复制本文件为 .env 即可运行
#   copy .env.example .env

# AI 视觉 OCR 与多模态抽取通道 (逍遥API - Gemini 视觉)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.openasi.bitmiracle.cn
VISION_MODEL=claude-sonnet-4-6

# 备用 + 视觉通道 (逍遥API - Gemini 3 Flash 高精视觉抽取)
OPENAI_API_KEY=sk-oV4q4jsM8eJ3w0wRdcaB0l4N5UFzCyRj9XkEM0IUcezUYCWO
OPENAI_BASE_URL=https://www.xiaoyaoapi.com/v1
OPENAI_VISION_MODEL=gemini-3-flash

# AI 文本对话 / 智能问询 / 报告润色通道 (DeepSeek 官方直连)
SOULHEALTH_LLM_MODEL=deepseek-chat
LLM_MODEL=deepseek-chat

# 运行模式：0=真实大模型模式，1=离线 MOCK 样例演示模式
SOULHEALTH_MOCK=0

# 启动时自动播种演示档案 demo/demo123456
SOULHEALTH_SEED_DEMO=1

SOULHEALTH_HOST=0.0.0.0
SOULHEALTH_PORT=8002
SOULHEALTH_SECRET=soulhealth-secret-key-prod-2026
SOULHEALTH_TOKEN_TTL_HOURS=8760
